# 本地/部署环境变量示例
# dev 环境会通过 application-dev.yml 的 spring.config.import
# 自动加载项目根目录或模块上级目录的 .env；
# 生产/测试环境请在 IDE Run Configuration、shell 或容器环境中设置变量。
# 不要把真实的 .env 提交到仓库（.gitignore 已忽略 .env）。

# ===== 数据库 =====
DB_URL=jdbc:mysql://localhost:3306/book_library?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# ===== JWT（必填，建议 32 位以上随机字符串）=====
JWT_SECRET=change-me-to-a-long-random-string

# ===== Redis（密码可选）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 测试环境数据库（application-test.yml）=====
TEST_DB_URL=jdbc:mysql://localhost:3306/library_test?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=change-me

# ===== Druid 监控（默认关闭；开启时必须同时设置账号密码）=====
DRUID_STAT_ENABLED=false
DRUID_USERNAME=
DRUID_PASSWORD=

# ===== 跨域（生产环境按实际前端域名配置）=====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
